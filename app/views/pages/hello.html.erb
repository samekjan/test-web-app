<% content_for :title, "Hello World" %>

<div class="min-h-screen bg-gray-950 flex items-center justify-center p-6 relative overflow-hidden">

  <%# decorative background blobs %>
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute -top-40 -left-40 w-96 h-96 bg-violet-600/20 rounded-full blur-3xl"></div>
    <div class="absolute -bottom-40 -right-40 w-96 h-96 bg-sky-600/20 rounded-full blur-3xl"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-indigo-600/10 rounded-full blur-3xl"></div>
  </div>

  <div class="relative z-10 text-center max-w-2xl mx-auto">

    <%# card %>
    <div class="bg-gray-900/60 border border-gray-800 backdrop-blur-sm rounded-2xl px-10 py-14 shadow-2xl">

      <%# eyebrow %>
      <p class="text-xs font-semibold tracking-widest uppercase text-gray-500 mb-6">
        Ruby on Rails &middot; Paketo Buildpacks
      </p>

      <%# heading with gradient %>
      <h1 class="text-6xl font-black tracking-tight mb-6 bg-gradient-to-br from-violet-400 via-sky-300 to-indigo-400 bg-clip-text text-transparent leading-tight">
        Chelloooooo big and very najs World!
      </h1>

      <%# divider %>
      <div class="w-16 h-px bg-gradient-to-r from-transparent via-gray-600 to-transparent mx-auto mb-6"></div>

      <%# subtitle %>
      <p class="text-gray-400 text-lg leading-relaxed">
        Jednoduchá webová aplikace běžící na&nbsp;
        <span class="text-gray-200 font-medium">Rails <%= Rails.version %></span>
        &nbsp;s&nbsp;
        <span class="text-gray-200 font-medium">Ruby <%= RUBY_VERSION %></span>.
      </p>

      <%# status badge %>
      <div class="mt-8 inline-flex items-center gap-2 bg-emerald-950/60 border border-emerald-800/50 text-emerald-400 text-sm font-medium px-4 py-2 rounded-full">
        <span class="w-2 h-2 bg-emerald-400 rounded-full animate-pulse"></span>
        Application running
      </div>

    </div>

    <%# footer note %>
    <p class="mt-6 text-gray-600 text-sm">
      Built with Paketo Buildpacks &bull; <%= Rails.env %>
    </p>

  </div>
</div>
