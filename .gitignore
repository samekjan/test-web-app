# Bundler
/.bundle
/vendor/bundle

# Environment
.env
.env.*

# SQLite databases
/storage/*.sqlite3
/storage/*.sqlite3-*

# Assets
/public/assets

# Logs
/log/**/*
!/log/.keep

# Temp files (keep directory structure for container permissions)
/tmp/restart.txt
/tmp/pids/*.pid
/tmp/cache/bootsnap/
/tmp/cache/assets/

# Rails credentials — master.key NEVER commit
/config/master.key
/config/credentials/*.key

# Test coverage
/coverage

# macOS
.DS_Store

# Editor
.idea/
.vscode/
*.swp
*.swo
